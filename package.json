{
  "name": "neu-companion",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "react": "19.2.3"
  },
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "build": "npm --workspace apps/api run build",
    "start:api": "npm --workspace apps/api run start:prod",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "setup": "npm install"
  }
}
