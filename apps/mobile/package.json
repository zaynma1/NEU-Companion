{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.18",
    "expo-font": "~57.0.2",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:local": "APP_ENV=local EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL:-http://localhost:3000/api} expo start",
    "android": "expo start --android",
    "android:local": "APP_ENV=local EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL:-http://10.0.2.2:3000/api} expo start --android",
    "ios": "expo start --ios",
    "ios:local": "APP_ENV=local EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL:-http://127.0.0.1:3000/api} expo start --ios",
    "preview:device": "APP_ENV=local EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL:-http://$(hostname -I | awk '{print $1}'):3000/api} expo start --tunnel",
    "web": "expo start --web",
    "preview:clear": "expo start --clear"
  },
  "private": true
}
